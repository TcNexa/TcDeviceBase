    <Method Name="publish" Id="{05ea8e29-d3b0-452d-9560-47281e9b8e60}">
      <Declaration><![CDATA[METHOD PUBLIC publish : BOOL
VAR_INPUT
	topic		: Tc2_System.T_MaxString;
	payload		: Tc2_System.T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_tmpText:= Tc2_Standard.CONCAT(
	STR1:= _topicPrefix,
	STR2:= topic);

publish:= _Client.Publish(
			sTopic			:= _tmpText,
			pPayload		:= ADR(payload),
			nPayloadSize	:= INT_TO_UDINT(Tc2_Standard.LEN(payload)),
			eQoS			:= TcIotMqttQos.AtMostOnceDelivery,
			bRetain			:= TRUE,
			bQueue			:= FALSE);]]></ST>
      </Implementation>
    </Method>
