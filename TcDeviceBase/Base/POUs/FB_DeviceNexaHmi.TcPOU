<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.13">
  <POU Name="FB_DeviceNexaHmi" Id="{31610939-7e9d-4c44-bbec-85bbd63ac92f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DeviceNexaHmi IMPLEMENTS TcNexa_Devices_Hmi_TcNexaHmi.I_NexaHmi
VAR
	(* Mqtt *)
	_Client						: Tc3_IotBase.FB_IotMqttClient;
	_ClientMessageQueue			: Tc3_IotBase.FB_IotMqttMessageQueue;
	_ClientMessage				: Tc3_IotBase.FB_IotMqttMessage;
	_isInit						: BOOL;
	_onClientConnection			: Tc2_Standard.R_TRIG;
	_isClientConnected			: BOOL;
	_onNewMessage				: BOOL;
	_willPayload				: STRING;
	_topicPrefix				: STRING(255);
	(* Message *)
	_messageTopic				: Tc2_System.T_MaxString;
	_messageLastTopicLevel		: Tc2_System.T_MaxString;
	_messageTopicSplitter		: TcNexa_Components_TcUtilities.FB_TextSplitter;
	_messagePayload				: Tc2_System.T_MaxString;		
	(* General *)
	_timerPublish				: Tc2_Standard.TON;		
	_tmpText					: Tc2_System.T_MaxString;					
	_tmpCounter					: USINT;			
	(* Information *)
	_cellTag					: STRING;
	_stationTag					: STRING;
	_tag						: STRING;
	_name						: STRING;
	_deviceType					: STRING;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Private" Id="{4c0fe852-9ce0-48f1-9eea-ab438145efaa}" />
    <Folder Name="Property" Id="{ac2259b0-596b-4594-9468-54cbef11ff21}" />
    <Method Name="_handleMessageQueue" Id="{dca2037c-839e-43a0-9acf-6ef3e3b5a4fd}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED _handleMessageQueue
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_onNewMessage:= FALSE;
IF (_ClientMessageQueue.nQueuedMessages > 0) THEN
	IF _ClientMessageQueue.Dequeue(fbMessage:= _ClientMessage)  THEN
		_ClientMessage.GetTopic(
			pTopic				:= ADR(_messageTopic),
			nTopicSize			:= SIZEOF(_messageTopic));
		_ClientMessage.GetPayload(
			pPayload			:= ADR(_messagePayload),
			nPayloadSize		:= SIZEOF(_messagePayload),
			bSetNullTermination	:= TRUE);
		_messageTopicSplitter.split(
			source				:= _messageTopic,
			delimiter			:= '/',
			Response			:= 0);
		_messageLastTopicLevel:= _messageTopicSplitter.getValueAt(
			index				:= _messageTopicSplitter.size,
			Response			:= 0);
		_onNewMessage:= TRUE;
	END_IF
ELSE
	_messageTopic:= '';
	_messagePayload:= '';
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_init" Id="{ab8543b6-9bf7-4a0c-9640-16102ede265a}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED _init
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _isInit THEN RETURN; END_IF
_isInit:= TRUE;

_Client.ipMessageQueue:= _ClientMessageQueue;

_tmpText:= '';
IF (_cellTag <> '') THEN
	_tmpText:= Tc2_Standard.CONCAT(STR1:= _cellTag, STR2:= '/');
END_IF
IF (_stationTag <> '') THEN
	_tmpText:= Tc2_Standard.CONCAT(STR1:= _tmpText, STR2:= _stationTag);
	_tmpText:= Tc2_Standard.CONCAT(STR1:= _tmpText, STR2:= '/');
END_IF
//_tmpText:= Tc2_Standard.CONCAT(STR1:= _tmpText, STR2:= 'devices/');
//_tmpText:= Tc2_Standard.CONCAT(STR1:= _tmpText, STR2:= _deviceType);
//_tmpText:= Tc2_Standard.CONCAT(STR1:= _tmpText, STR2:= '/');
//_tmpText:= Tc2_Standard.CONCAT(STR1:= _tmpText, STR2:= _tag);
//_tmpText:= Tc2_Standard.CONCAT(STR1:= _tmpText, STR2:= '/');
_topicPrefix:= '';
_topicPrefix:= Tc2_Standard.CONCAT(STR1:= _topicPrefix, STR2:= 'devices/');
_topicPrefix:= Tc2_Standard.CONCAT(STR1:= _topicPrefix, STR2:= _deviceType);
_topicPrefix:= Tc2_Standard.CONCAT(STR1:= _topicPrefix, STR2:= '/');
_topicPrefix:= Tc2_Standard.CONCAT(STR1:= _topicPrefix, STR2:= _tag);
_topicPrefix:= Tc2_Standard.CONCAT(STR1:= _topicPrefix, STR2:= '/');

_Client.sTopicPrefix:= _tmpText;
_Client.sClientId:= CONCAT(STR1:= _tmpText, STR2:= _topicPrefix);
(* Will *)
_willPayload:= BOOL_TO_STRING(FALSE);
_Client.stWill.sTopic:= Tc2_Standard.CONCAT(STR1:= _topicPrefix, STR2:= 'active');
_Client.stWill.pPayload:= ADR(_willPayload);
_Client.stWill.nPayloadSize:= INT_TO_UDINT(Tc2_Standard.LEN(_willPayload));
_Client.stWill.eQoS:= TcIotMqttQos.AtMostOnceDelivery;
_Client.stWill.bRetain:= TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_onConnection" Id="{84dcacd7-23ca-48c2-9025-8b065b67c935}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED _onConnection
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _onClientConnection.Q THEN RETURN; END_IF

(*** PUBLISH ***)
publish(
	topic	:= 'active',
	payload	:= BOOL_TO_STRING(TRUE));
publish(
	topic	:= 'general/name',
	payload	:= _name);]]></ST>
      </Implementation>
    </Method>
